  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8290B1",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7ED9B5"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#83B9FF"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.brackets",
        "meta.parentheses"
      ],
      "settings": {
        "foreground": "#7189AA"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B07CFF"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "constant.character"
      ],
      "settings": {
        "foreground": "#FFA500"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#5EAFFF"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.return-type"
      ],
      "settings": {
        "foreground": "#966CCA"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#A6CAFF"
      }
    },
    {
      "name": "JSON properties",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json.comments",
        "support.type.property-name.json.lines"
      ],
      "settings": {
        "foreground": "#A6CAFF"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#FF4DE1"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA500"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.constant.property-value"
      ],
      "settings": {
        "foreground": "#A6CAFF"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A6CAFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#7CBEFF"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF4DE1",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#966CCA",
    "type": "#966CCA",
    "class": "#FFD700",
    "enum": "#966CCA",
    "interface": "#966CCA",
    "struct": "#966CCA",
    "typeParameter": "#966CCA",
    "parameter": "#A6CAFF",
    "variable": "#A6CAFF",
    "property": "#A6CAFF",
    "enumMember": "#FFA500",
    "function": "#5EAFFF",
    "method": "#5EAFFF",
    "macro": "#5EAFFF",
    "keyword": "#B07CFF",
    "modifier": "#B07CFF",
    "comment": "#8290B1",
    "string": "#7ED9B5",
    "number": "#FFA500",
    "regexp": "#7ED9B5",
    "operator": "#83B9FF",
    "decorator": "#FFD700"
  }
}
