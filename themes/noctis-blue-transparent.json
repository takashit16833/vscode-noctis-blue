  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#465082",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A6CAFF"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#83B9FF"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.brackets",
        "meta.parentheses"
      ],
      "settings": {
        "foreground": "#6694CA"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A6CAFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "constant.character"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#87CEEB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "meta.return-type"
      ],
      "settings": {
        "foreground": "#B07CFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#A6CAFF"
      }
    },
    {
      "name": "JSON properties",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json.comments",
        "support.type.property-name.json.lines"
      ],
      "settings": {
        "foreground": "#5EAFFF"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#5EAFFF"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.constant.property-value"
      ],
      "settings": {
        "foreground": "#7CBEFF"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A6CAFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#7CBEFF"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF4DE1",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#B07CFF",
    "type": "#B07CFF",
    "class": "#B07CFF",
    "enum": "#B07CFF",
    "interface": "#B07CFF",
    "struct": "#B07CFF",
    "typeParameter": "#B07CFF",
    "parameter": "#A6CAFF",
    "variable": "#7CBEFF",
    "property": "#A6CAFF",
    "enumMember": "#FFD700",
    "function": "#87CEEB",
    "method": "#87CEEB",
    "macro": "#5EAFFF",
    "keyword": "#A6CAFF",
    "modifier": "#5EAFFF",
    "comment": "#465082",
    "string": "#A6CAFF",
    "number": "#FFD700",
    "regexp": "#A6CAFF",
    "operator": "#83B9FF",
    "decorator": "#FFD700"
  }
}
