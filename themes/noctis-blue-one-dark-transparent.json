  ],
  "semanticTokenColors": {
    "namespace": "#A6CAFF",
    "class": "#FFD700",
    "type": "#FFD700",
    "enum": "#FFD700",
    "interface": "#FFD700",
    "struct": "#FFD700",
    "typeParameter": "#FFD700",
    "type.defaultLibrary": "#00CED1",
    "variable": "#FF4DE1",
    "parameter": "#A6CAFF",
    "parameter:python": "#FFA500",
    "property": "#A6CAFF",
    "property:json": "#FF4DE1",
    "property:jsonc": "#FF4DE1",
    "property:jsonl": "#FF4DE1",
    "enumMember": "#FFA500",
    "function": "#5EAFFF",
    "method": "#5EAFFF",
    "macro": "#5EAFFF",
    "function.defaultLibrary": "#00CED1",
    "keyword": "#B07CFF",
    "modifier": "#B07CFF",
    "comment": {
      "foreground": "#8290B1",
      "italic": true
    },
    "string": "#7ED9B5",
    "number": "#FFA500",
    "regexp": "#00CED1",
    "decorator": "#FFD700"
